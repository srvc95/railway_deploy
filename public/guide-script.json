{
  "version": 6,
  "steps": [
    { "id": "prepared", "act": 1, "title": "Keel starts before you do", "badge": "ai", "auto": true, "asks": { "primary": "R1" },
      "body": "Dottie's plan ends Dec 31 and she left a voicemail last night. Nobody asks Keel to work her case. Watch.",
      "met": "Ready before anyone asked: voicemail read, 5 plans checked, email written and checked.",
      "target": "[data-testid=prep-feed]",
      "task": [{ "label": "Keel prepares Dottie's case", "control": "[data-testid=prep-feed]", "done": { "step": "action.gate", "status": "done" } }],
      "view": { "hash": "#home", "why": "closed", "reveal": "top" }, "metView": { "hash": "#home", "why": "closed", "reveal": "top" },
      "place": "rail-lower" },
    { "id": "outcome", "act": 1, "title": "What it means for Dottie", "badge": "rules", "asks": { "primary": "R1" },
      "body": "The result in four numbers.",
      "met": "She keeps both her doctors and all 4 medicines for $18 a month. A cheaper plan was turned down because her heart doctor is not in it.",
      "target": "[data-testid=outcome-strip]",
      "task": [{ "label": "Review the result", "control": "[data-testid=outcome-strip]", "done": { "step": "decision.recommend", "status": "done" } }],
      "view": { "hash": "#member/dottie-hayes/overview", "why": "closed", "reveal": "top" }, "metView": { "hash": "#member/dottie-hayes/overview", "why": "closed", "reveal": "top" },
      "place": "rail-lower" },
    { "id": "voicemail", "act": 1, "title": "Her words, not guesses", "badge": "ai", "asks": { "primary": "R1", "also": ["R4"] },
      "body": "The AI turned her voicemail into preferences.",
      "met": "Each preference quotes what Dottie actually said, so every claim can be checked.",
      "target": "[data-facet=preferences]",
      "task": [{ "label": "Read her preferences", "control": "[data-facet=preferences]", "done": { "step": "signal.interpret", "status": "done" } }],
      "view": { "hash": "#member/dottie-hayes/overview", "why": "closed", "reveal": "[data-facet=preferences]" }, "metView": { "hash": "#member/dottie-hayes/overview", "why": "closed", "reveal": "[data-facet=preferences]" },
      "place": "main-lower-left" },
    { "id": "why", "act": 1, "title": "Why this plan?", "badge": "rules", "asks": { "primary": "R2" },
      "body": "Open the reasons behind the recommendation.",
      "met": "Every rule, its version and the records it used. Rules pick the plan; the AI only reads and writes.",
      "target": "[data-testid=why-summary]",
      "task": [{ "label": "Why this action?", "control": "[data-testid=why-open]", "done": { "ui": "why" } }],
      "view": { "hash": "#member/dottie-hayes/overview", "why": "closed", "reveal": "[data-testid=why-open]" }, "metView": { "hash": "#member/dottie-hayes/overview", "why": "open", "reveal": "[data-testid=why-summary]" },
      "place": "main-lower-left" },
    { "id": "draft", "act": 2, "title": "Her email is ready", "badge": "ai", "asks": { "primary": "R3", "also": ["R4"] },
      "body": "The AI wrote her email from approved facts only.",
      "met": "Written by AI, checked by rules: {gateHeadline}.",
      "target": "[data-testid=draft]",
      "task": [{ "label": "Read her email", "control": "[data-testid=draft]", "done": { "step": "action.gate", "status": "done" } }],
      "view": { "hash": "#member/dottie-hayes/outreach", "why": "closed", "reveal": "[data-testid=draft]" }, "metView": { "hash": "#member/dottie-hayes/outreach", "why": "closed", "reveal": "[data-testid=draft]" },
      "place": "rail-lower" },
    { "id": "blocked", "act": 2, "title": "A risky edit is stopped", "badge": "rules", "asks": { "primary": "R3", "also": ["R1"] },
      "body": "Ryan edits the message to text Dottie that her drugs are “free”. She asked not to be texted. Press Edit and send.",
      "met": "{gateHeadline}. Nothing reached Dottie.",
      "target": "[data-testid=compliance-view]",
      "task": [{ "label": "Edit and send", "control": "[data-testid=request-changes]", "done": { "step": "human.approve", "status": "waiting" } }],
      "view": { "hash": "#member/dottie-hayes/outreach", "why": "closed", "reveal": "top" }, "metView": { "hash": "#member/dottie-hayes/outreach", "why": "closed", "reveal": "[data-testid=compliance-view]" },
      "place": "rail-lower" },
    { "id": "approve", "act": 2, "title": "A person signs off", "badge": "human", "asks": { "primary": "R4", "also": ["R3", "R5"] },
      "body": "Switch to Supervisor, then approve as Carol Sutton.",
      "met": "Approved. The email went out, the CRM was updated, a follow-up task and a prior-approval case were opened.",
      "target": "[data-testid=closed-loop]", "context": "[data-testid=approval-card]", "show": ["[data-testid=plan-comparison] .stage-best"],
      "task": [
        { "label": "Supervisor", "control": "[data-testid=role-supervisor]", "done": { "ui": "supervisor" } },
        { "label": "Approve", "control": "[data-testid=approve]", "done": { "step": "action.escalate", "status": "done" } }],
      "view": { "hash": "#member/dottie-hayes/outreach", "why": "closed", "reveal": "top" }, "metView": { "hash": "#member/dottie-hayes/outreach", "why": "closed", "reveal": "[data-testid=closed-loop]" },
      "place": "main-lower-left" },
    { "id": "reply", "act": 3, "title": "Dottie writes back", "badge": "system", "asks": { "primary": "R5", "also": ["R4"] },
      "body": "Simulate Dottie's reply.",
      "met": "Keel read her reply, set the next action and updated the CRM. Nobody typed anything.",
      "target": "[data-testid=crm-record] .tbl-wrap",
      "task": [{ "label": "Simulate member reply", "control": "[data-testid=simulate-reply]", "done": { "step": "decision.next-action", "status": "done" } }],
      "view": { "hash": "#crm/record", "why": "closed", "reveal": "top" }, "metView": { "hash": "#crm/record", "why": "closed", "reveal": "top" },
      "place": "top-right-under-header" },
    { "id": "replay", "act": 3, "title": "Prove a decision a year later", "badge": "rules", "asks": { "primary": "R2" },
      "body": "An auditor asks about Dottie's plan choice from last November. Replay it with that day's rules.",
      "met": "Reproduced exactly, with the same fingerprint.",
      "target": "[data-testid=replay-original-result]",
      "task": [{ "label": "Replay Nov 12, 2025", "control": "[data-testid=replay-original]", "done": { "ui": "replayOriginal" } }],
      "view": { "hash": "#member/dottie-hayes/overview", "why": "open", "tab": "replay", "reveal": "[data-testid=replay-original]" }, "metView": { "hash": "#member/dottie-hayes/overview", "why": "open", "tab": "replay", "reveal": "[data-testid=replay-original-result]" },
      "place": "main-lower-left" },
    { "id": "audit", "act": 3, "title": "Ready for any audit", "badge": "data", "asks": { "primary": "R6", "also": ["R5"] },
      "body": "Build the audit package, then open its report.",
      "met": "Prepared, governed, preserved.",
      "target": "[data-testid=audit-counts]",
      "task": [
        { "label": "Build audit", "control": "[data-testid=build-audit]", "done": { "step": "briefing.audit", "status": "done" } },
        { "label": "Open audit report", "control": "[data-testid=open-audit-report]", "done": { "ui": "auditReport" } }],
      "view": { "hash": "#performance/audit", "why": "closed", "reveal": "top" }, "metView": { "hash": "#performance/audit", "why": "closed", "reveal": "top" },
      "place": "under-tabs", "placeMet": "left-of-sheet" }
  ]
}
