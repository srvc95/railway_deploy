{
  "name": "keel-medicare-demo",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run guard && vitest run && npm run test:e2e",
    "test:unit": "vitest run",
    "test:rules": "vitest run tests/unit/rules",
    "test:e2e": "playwright test --pass-with-no-tests && playwright test -c tests/support/ui-fixtures/playwright.ui.config.ts && playwright test -c tests/support/ask-dock/playwright.config.ts",
    "test:queue": "node scripts/pw-queue.mjs",
    "test:affected": "node scripts/test-affected.mjs",
    "test:live": "playwright test --config playwright.live.config.ts",
    "test:verify": "playwright test tests/verify --pass-with-no-tests",
    "eval": "tsx evals/runner.ts",
    "eval:ask": "tsx evals/ask/cli.ts",
    "health": "tsx scripts/health.ts",
    "guard": "tsx scripts/guard.ts",
    "verify:models": "tsx scripts/verify-models.ts",
    "chaos": "tsx scripts/chaos.ts",
    "failures": "tsx scripts/failures.ts",
    "audit:verify": "tsx scripts/audit-verify.ts",
    "package": "node scripts/package-demo.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.4",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "fflate": "0.8.3",
    "hono": "4.13.13",
    "openai": "7.30.0",
    "zod": "4.6.5"
  }
}
